APP_NAME=ReelReverse
DATA_DIR=./data
# 留空时使用 DATA_DIR/app.db；也可填写 sqlite:///... 或 PostgreSQL URL。
DATABASE_URL=

# HTTP Basic 认证。默认 fail-closed：APP_PASSWORD 为空且未显式允许无认证时拒绝业务请求。
# 仅本地开发可设置 ALLOW_INSECURE_NO_AUTH=true；生产环境请配置强密码并启用 HTTPS。
APP_USERNAME=admin
APP_PASSWORD=
ALLOW_INSECURE_NO_AUTH=false
AUTH_MAX_FAILURES=10
AUTH_FAILURE_WINDOW_S=60

# mock = 不调用外部模型，使用可复现的模拟分析
# openai = 任何 OpenAI 兼容网关（OpenAI / DeepSeek / 通义 / 私有网关）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=

# 可选：成本估算单价（每 100 万 token）。留空/0 时只展示 token，不计算金额。
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
COST_CURRENCY=USD

# 分析前成本预估假设，可按实际模型与平均提示词长度校准。
COST_ESTIMATE_SECONDS_PER_SHOT=3.5
COST_ESTIMATE_PROMPT_TOKENS_PER_SHOT=1500
COST_ESTIMATE_COMPLETION_TOKENS_PER_SHOT=450

# 本地/私有网关示例（OpenAI 兼容，注意 base 要带 /v1）
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=dashscope/qwen3.7-plus
# VISION_MODEL=dashscope/qwen3.7-plus

# none / openai（OpenAI 兼容的 /audio/transcriptions）
ASR_PROVIDER=none
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1

MAX_UPLOAD_MB=500
MAX_REQUEST_MB=16
MAX_COMMENT_BODY_KB=32
MAX_SHOTS=24
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
SCENE_THRESHOLD=0.32
MIN_SHOT_SECONDS=0.8
LLM_CONCURRENCY=2
REQUEST_TIMEOUT_S=180
MAX_ACTIVE_JOBS=4
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.8
RETRY_MAX_DELAY_S=8
PROMPT_CATALOG_FILE=
MOCK_SCENARIO=success
MOCK_FAIL_SHOT=0

# SSE 与公开评论限流。
SSE_HEARTBEAT_S=15
SSE_MAX_SECONDS=900
SSE_MAX_CONNECTIONS=32
SHARE_COMMENT_LIMIT=10
SHARE_COMMENT_WINDOW_S=60

# 持久任务队列。租约用于进程重启恢复，长任务会自动续租。
TASK_LEASE_S=120
TASK_POLL_INTERVAL_S=2
TASK_MAX_ATTEMPTS=2

# Video generation. Keep credentials server-side only.
# mock = local placeholder output used to validate the full workflow.
VIDEO_PROVIDER=mock
VIDEO_MODEL=mock-v1
VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_REQUEST_TIMEOUT_S=180
VIDEO_POLL_INTERVAL_S=2
VIDEO_TIMEOUT_S=600
MAX_ACTIVE_GENERATION_JOBS=2
GENERATION_RETRY_ATTEMPTS=2
