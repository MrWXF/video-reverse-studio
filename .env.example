APP_NAME=ReelReverse
DATA_DIR=./data

# 可选 HTTP Basic 认证；APP_PASSWORD 留空则关闭。生产环境请同时启用 HTTPS。
APP_USERNAME=admin
APP_PASSWORD=

# mock = 不调用外部模型，使用可复现的模拟分析
# openai = 任何 OpenAI 兼容网关（OpenAI / DeepSeek / 通义 / 私有网关）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=

# 可选：成本估算单价（每 100 万 token）。留空/0 时只展示 token，不计算金额。
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
COST_CURRENCY=USD

# 本地/私有网关示例（OpenAI 兼容，注意 base 要带 /v1）
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=dashscope/qwen3.7-plus
# VISION_MODEL=dashscope/qwen3.7-plus

# none / openai（OpenAI 兼容的 /audio/transcriptions）
ASR_PROVIDER=none
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1

MAX_UPLOAD_MB=500
MAX_SHOTS=24
SCENE_THRESHOLD=0.32
MIN_SHOT_SECONDS=0.8
LLM_CONCURRENCY=2
REQUEST_TIMEOUT_S=180
